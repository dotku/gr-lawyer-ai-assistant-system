// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(LAWYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases         Case[]
  documents     Document[]
  tasks         Task[]
  notes         Note[]
  conversations AIConversation[]
  intakes       Intake[]
  intakeNotes   IntakeNote[]

  @@map("users")
}

enum UserRole {
  ADMIN
  LAWYER
  PARALEGAL
  CLIENT
}

// Client model
model Client {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  address     String?
  dateOfBirth DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases       Case[]

  @@map("clients")
}

// Case model
model Case {
  id            String     @id @default(cuid())
  caseNumber    String     @unique
  title         String
  description   String?
  status        CaseStatus @default(OPEN)
  priority      Priority   @default(MEDIUM)
  caseType      String
  state         String?
  startDate     DateTime   @default(now())
  endDate       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Matter workspace fields
  summary       Json?      // Structured summary data
  nextActions   Json?      // Array of next actions
  communications Json?     // Latest communications
  checklist     Json?      // Document checklist items

  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedToId  String
  assignedTo    User       @relation(fields: [assignedToId], references: [id])

  documents     Document[]
  tasks         Task[]
  notes         Note[]
  conversations AIConversation[]
  intakeSource  Intake?

  @@map("cases")
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  PENDING
  CLOSED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Document model
model Document {
  id          String       @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int
  category    DocumentCategory
  uploadedAt  DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  caseId      String?
  case        Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

enum DocumentCategory {
  CONTRACT
  EVIDENCE
  PLEADING
  CORRESPONDENCE
  RESEARCH
  OTHER
}

// Task model
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caseId      String?
  case        Case?      @relation(fields: [caseId], references: [id], onDelete: SetNull)

  assignedToId String
  assignedTo   User      @relation(fields: [assignedToId], references: [id])

  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Note model
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  @@map("notes")
}

// AI Conversation model
model AIConversation {
  id        String   @id @default(cuid())
  title     String
  messages  Json     // Store conversation messages as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("ai_conversations")
}

// Intake workflow models
model Intake {
  id            String        @id @default(cuid())
  intakeNumber  String        @unique
  clientName    String
  clientEmail   String
  clientPhone   String?
  status        IntakeStatus  @default(NEW)
  category      String?
  tags          String[]
  shareSettings String        @default("Only those invited")
  summary       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignedToId    String?
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])

  convertedCaseId String?       @unique
  convertedCase   Case?         @relation(fields: [convertedCaseId], references: [id])

  schedules    IntakeSchedule[]
  notices      IntakeNotice[]
  questions    IntakeQuestion[]
  notes        IntakeNote[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("intakes")
}

enum IntakeStatus {
  NEW
  PROCESSING
  NEED_REVIEW
  SENT
  ARCHIVED
  CONVERTED
}

model IntakeSchedule {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  time        String
  meetingLink String?
  type        String   // "zoom", "meeting", etc.
  createdAt   DateTime @default(now())

  intakeId    String
  intake      Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("intake_schedules")
}

model IntakeNotice {
  id        String   @id @default(cuid())
  content   String
  isStarred Boolean  @default(false)
  createdAt DateTime @default(now())

  intakeId  String
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("intake_notices")
}

model IntakeQuestion {
  id        String   @id @default(cuid())
  question  String
  answer    String?
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakeId  String
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@map("intake_questions")
}

model IntakeNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  intakeId  String
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  @@map("intake_notes")
}
